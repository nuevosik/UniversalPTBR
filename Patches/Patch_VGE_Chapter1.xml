<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Gravship Expanded - Chapter 1</li>
      <li>vanillaexpanded.gravship</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/QuestScriptDef[defName="VGE_OpportunitySite_SolidCoreAsteroid"]/root/nodes/li[@Class="QuestNode_IsSet"]/elseNode[@Class="QuestNode_RandomNode"]/nodes/li[@Class="QuestNode_Set"]/value</xpath>
          <value>
            <value>Você descobriu</value>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>Defs/PipeSystem.PipeNetDef[defName="VGE_OxygenNet"]/resource/name</xpath>
          <value>
            <name>Oxigênio</name>
          </value>
        </li>
        
        <li Class="PatchOperationReplace">
        <xpath>Defs/PipeSystem.PipeNetDef[defName="VGE_AstrofuelNet"]/resource</xpath>
        <value>
          <resource>
            <name>Astrocombustível</name>
            <unit>L</unit>
            <color>(0.54, 0.30, 0.85)</color>
            <offTexPath>Things/Items/Resource/Astrofuel</offTexPath>
          </resource>
        </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>